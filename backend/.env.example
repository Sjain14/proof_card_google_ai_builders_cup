# Copy to .env for local dev and fill your OWN values. Never commit .env, never paste keys in chat.
PC_ENV=local
PC_GCP_PROJECT=
PC_PUBLIC_BASE_URL=http://localhost:8080
# On Cloud Run these two come from Secret Manager (pinned versions), not from this file.
PC_TELEGRAM_BOT_TOKEN=
PC_TELEGRAM_WEBHOOK_SECRET=
