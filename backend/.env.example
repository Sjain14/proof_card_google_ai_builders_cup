# Copy to .env for local dev and fill your OWN values. Never commit .env, never paste keys in chat.
PC_ENV=local
PC_GCP_PROJECT=
PC_PUBLIC_BASE_URL=http://localhost:8080
# On Cloud Run these two come from Secret Manager (pinned versions), not from this file.
PC_TELEGRAM_BOT_TOKEN=
PC_TELEGRAM_WEBHOOK_SECRET=
# Optional: Google Fact Check Tools API key (Secret Manager on Cloud Run). Empty = off.
PC_FACTCHECK_API_KEY=
# Model: stub = offline demo facts (no GCP needed); vertex = Gemini on Vertex AI.
PC_MODEL_MODE=stub
# Infra region (Cloud Run, Tasks, Firestore, GCS). Models have their own locations below.
PC_GCP_REGION=asia-south1
# gemini-2.5-flash retires 20 Oct 2026; keep a GA model with a far retirement date.
PC_GEMINI_MODEL=gemini-3.5-flash
PC_GEMINI_REGION=global
# gemini-3.5-transcribe-live only exists in global / us / eu.
PC_LIVE_MODEL=gemini-3.5-transcribe-live
PC_LIVE_REGION=global
PC_EMBED_MODEL=gemini-embedding-001
PC_EMBED_REGION=
PC_PROOF_BUCKET=
# Jobs: inline locally; cloudtasks on Cloud Run (needs PC_SERVICE_URL + PC_TASKS_SA_EMAIL).
PC_TASKS_MODE=inline
PC_TASKS_QUEUE=prebunk
PC_TASKS_SA_EMAIL=
PC_SERVICE_URL=
