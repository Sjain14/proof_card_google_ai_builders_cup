# Copy to .env.local (gitignored). Firebase web config is public, not a secret
# (https://firebase.google.com/docs/projects/api-keys). Leave empty for local dev mode
# against a backend started with PC_AUTH_DISABLED=true.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Cloud Run URL from E09 (https://proofcard-api-...run.app). Needed for the prod build:
# live sessions and clip uploads skip the 60 s Hosting rewrite. Empty = same origin (dev proxy).
VITE_LIVE_ORIGIN=
